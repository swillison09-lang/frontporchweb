# Cloudflare Pages redirect rules.
# Format: <from>  <to>  <status>

# Retire the deleted dress-rehearsal client site. The page was removed from the
# repo, but Pages kept serving a stale copy of the directory URL (its own cache
# sets s-maxage=604800, so a zone purge does not clear it). This rule takes
# priority over the stale asset and sends visitors to the homepage. Safe to
# delete once the cache has aged out.
/clients/the-smith-family/*  /  301

# The front-porch-evening demo became the homepage on 2026-09-12.
/demos/front-porch-evening/*  /  301
# Sites were sorted into two sections on 2026-10-27: /demos/<slug>/ for
# businesses, families and orgs, /athletes/<slug>/ for recruiting profiles.
# Old addresses (already sent to prospects and coaches) keep working. Pages
# serves /x.html at /x too, so each old page gets both forms.
/demos/dunn-right.html                /demos/fresh-cut-lawn-care/  301
/demos/dunn-right                     /demos/fresh-cut-lawn-care/  301
/demos/fresh-cut-logo.png             /demos/fresh-cut-lawn-care/logo.png  301
/demos/hartman-plumbing.html          /demos/hartman-plumbing/  301
/demos/bennett-family-adoption.html   /demos/bennett-family/  301
/demos/bennett-family-adoption        /demos/bennett-family/  301
/demos/bennett-assets/*               /demos/bennett-family/img/:splat  301
/demos/asfg.html                      /demos/asfg/  301
/demos/asfg-assets/*                  /demos/asfg/img/:splat  301
/demos/recruiting.html                /athletes/tyler-brooks/  301
/demos/recruiting                     /athletes/tyler-brooks/  301
/demos/gavin-mcgee                    /athletes/gavin-mcgee/  301
/demos/gavin-mcgee/*                  /athletes/gavin-mcgee/:splat  301

# The section folders themselves have no page; send them to the work grid.
/demos      /#work  302
/demos/     /#work  302
/athletes   /#work  302
/athletes/  /#work  302

# Retire the stale Hartman backup. The file was removed from the repo, but
# Pages keeps serving its cached copy at both the .html and extensionless URL
# (same behaviour as the smith-family rule above: its own cache sets a long
# s-maxage, so a zone purge does not clear it). These rules take priority over
# the stale asset and send anyone who lands there to the real demo.
# Safe to delete once the cache has aged out.
/demos/hartman-plumbing.OLD.html  /demos/hartman-plumbing/  301
/demos/hartman-plumbing.OLD       /demos/hartman-plumbing/  301

# The classic page was replaced by the standard view on 2026-09-22. The 3D
# homepage's "Standard Site" button links to /standard; anything still pointing
# at the old URL lands there too.
/classic.html  /standard  301
/classic       /standard  301

# Internal setup files live in the repo but are not for the public: they map out
# the database rules, the upload worker and the Cloudflare setup. Pages serves
# every repo file, and these rules take priority over the asset.
/README.md             /  301
/CLOUDFLARE-SETUP.md   /  301
/supabase-schema.sql   /  301
/blog-schema.sql       /  301
/.gitignore            /  301
/worker/*              /  301
